# --- Deployment (compose) ---
# Image tag: main, sha-<7>, or a release.
VIEWER_VERSION=main
# Where web listens on the host.
VIEWER_BIND=127.0.0.1
VIEWER_PORT=3000
POSTGRES_PASSWORD=

# --- Sign-in ---
# The public URL; also the MCP resource (<url>/mcp) and issuer base.
BETTER_AUTH_URL=https://viewer.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# A confidential OIDC client in your Keycloak realm, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/keycloak.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Observability (optional; off when the endpoint is empty) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=viewer

# --- Document storage (Nextcloud WebDAV) ---
# An app password of the account that holds the files. Everything goes
# under NEXTCLOUD_ROOT in that account's files, nothing outside it.
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT=viewer

# Invitation mail goes through portal.winlab.tw: a service key made by a
# portal admin on /api-keys, allowed to send invitations. Empty: no mail.
PORTAL_URL=https://portal.winlab.tw
PORTAL_SERVICE_KEY=
